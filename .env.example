# ---------------------------------------------------------------------------
# Copy to .env and adjust before running docker compose.
# Compose interpolates these values; every setting has a safe default.
# ---------------------------------------------------------------------------

# Browser-facing port. On this host it is served by the tiny TCP/MSS proxy,
# which forwards to Nginx and works around a broken large-TCP-segment path
# (see README section 10).
APP_PORT=8080

# Internal port where the proxy reaches Nginx (bound to 127.0.0.1 only).
NGINX_INTERNAL_PORT=8081

# TCP MSS advertised by the workaround proxy. 1200 is safe for IPv4 and IPv6.
PROXY_MSS=1200

# Public URL used to build short links (no trailing slash)
BASE_URL=http://localhost:8080

# Optional: DNS server Nginx uses to re-resolve backend replicas.
# Leave empty to auto-detect from /etc/resolv.conf (works with Docker & Podman).
# NGINX_RESOLVER=127.0.0.11

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener

# ---------------------------------------------------------------- Security
# MUST be replaced with a long random value in any real deployment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------ Business rules
# Fixed lifetime of anonymous (Redis-only) links in seconds (default 7 days)
ANONYMOUS_LINK_TTL_SECONDS=604800

# Strict URL validation: DNS is always checked; the HTTP HEAD probe can be
# disabled in air-gapped environments.
URL_HTTP_CHECK_ENABLED=true
# Never enable on a public instance (SSRF protection)
ALLOW_PRIVATE_HOSTS=false

# --------------------------------------------------------------- Rate limits
RATE_LIMIT_ENABLED=true
LINK_CREATION_RATE_LIMIT=10/minute

# ------------------------------------------------------------------- Misc
ENVIRONMENT=production
DEBUG=false
